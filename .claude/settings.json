{
  "permissions": {
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/claude-md-gate.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "claude-md-management@claude-plugins-official": true,
    "linear@claude-plugins-official": true
  }
}
