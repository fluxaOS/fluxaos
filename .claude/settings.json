{
  "__meta": {
    "managed_by": "fhc sync",
    "note": "DO NOT EDIT \u2014 this file is overwritten by fhc sync. Edit templates/claude-settings/settings.json in fh-commons."
  },
  "hooks": {
    "postToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/write-guard.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '\u26a0\ufe0f  REMINDER: This repository uses Forgejo (NOT GitHub)' && echo '   \u2705 ALWAYS use: flu git commands' && echo '   \u274c NEVER use: gh or tea commands'"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "codex@openai-codex": true
  },
  "permissions": {
    "deny": [
      "Bash(gh:*)",
      "Bash(gh)",
      "Bash(tea:*)",
      "Bash(tea)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/*.token)",
      "Read(.forgejo_token)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Edit(**/*.token)"
    ]
  }
}
