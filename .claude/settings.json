{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/*.token)",
      "Read(.forgejo_token)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Edit(**/*.token)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/write-guard.sh"
          }
        ]
      }
    ],
    "SessionStart": []
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "claude-md-management@claude-plugins-official": true
  },
  "__meta": {
    "managed_by": "fhc sync",
    "note": "DO NOT EDIT — this file is overwritten by fhc sync. Edit templates/claude-settings/settings.json in fh-commons."
  }
}
