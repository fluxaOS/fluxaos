"""
fluxaos CLI - Unified wrapper for fh-commons

Smart bootstrap wrapper that:
- Detects Python vs non-Python projects
- Auto-bootstraps Poetry venv for Python projects only
- Routes through CliApp (config-driven command routing)
- Works for both Python and non-Python projects

Bootstrap flow:
  ./cli install
      │
      ├─ Python project (has pyproject.toml)?
      │   ├─ Not in venv?
      │   │   ├─ Run: poetry install (creates venv)
      │   │   └─ Re-exec: poetry run python3 ./cli install
      │   └─ In venv → Continue to CliApp
      │
      └─ Non-Python project?
          └─ Run directly (no Poetry bootstrap)

      Both paths:
      └─ CliApp (config-driven routing for project commands, shared commands)
"""

import os
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

# Project configuration
PROJECT_NAME = "fluxaos"
CLI_NAME = "flu"

# Set app name for fh-commons to use in help text and error messages
os.environ['FHC_APP_NAME'] = CLI_NAME

# Directories
SCRIPT_DIR = Path(__file__).resolve().parent

# fh-commons directory - set during project setup, with fallback to environment variable
_FH_COMMONS_PATH = "/mnt/dev/fh-commons"  # Set during fhc project setup
if _FH_COMMONS_PATH.startswith("{"):
    # Placeholder not substituted - use environment variable or error
    _FH_COMMONS_PATH = os.environ.get('FH_COMMONS_PATH', '')
    if not _FH_COMMONS_PATH:
        print("Error: fh-commons directory not configured. "
              "Please set FH_COMMONS_PATH environment variable.")
        sys.exit(1)

FH_COMMONS_DIR = Path(_FH_COMMONS_PATH)
if not FH_COMMONS_DIR.exists():
    print(f"Error: fh-commons directory not found at /mnt/dev/fh-commons")
    print("Please verify the path or set FH_COMMONS_PATH environment variable.")
    sys.exit(1)


def is_python_project():
    """Detect if this is a Python project by checking for pyproject.toml."""
    return (SCRIPT_DIR / 'pyproject.toml').exists()


def is_running_in_poetry_venv():
    """Check if we're running inside a Poetry virtual environment for this project.

    Accepts two cases:
    1. The standard case: VIRTUAL_ENV points to THIS project's ``.venv`` dir.
    2. The shared-venv case: poetry resolves to a dependency's venv (e.g.,
       fh-commons's ``.venv``) because the project has a path dependency on it.
       In this case VIRTUAL_ENV is relative to FH_COMMONS_DIR instead of
       SCRIPT_DIR — we accept it as a valid venv since fh-commons packages are
       available there (#2595).
    """
    venv = os.environ.get('VIRTUAL_ENV', '')
    if not venv or ('pypoetry' not in venv and '.venv' not in venv):
        return False
    venv_path = Path(venv).resolve()
    # Case 1: project's own venv (#1827 guard — must be THIS project's venv)
    if venv_path.is_relative_to(SCRIPT_DIR):
        return Path(venv, 'pyvenv.cfg').exists()
    # Case 2: fh-commons shared venv (path-dependency scenario)
    if venv_path.is_relative_to(FH_COMMONS_DIR):
        return Path(venv, 'pyvenv.cfg').exists()
    return False


def _get_service_lifecycle_action(argv: list[str]) -> tuple[str, str] | None:
    """Return (service_name, action) for `service <name> start|stop|restart`."""
    if len(argv) < 3:
        return None
    if argv[0] != "service":
        return None
    service_name = argv[1]
    action = argv[2]
    if action not in {"start", "stop", "restart"}:
        return None
    return service_name, action


def _pid_cmdline(pid: int) -> str:
    """Return full process cmdline for pid, or empty string if unreadable."""
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return ""
    return raw.replace(b"\x00", b" ").decode("utf-8", errors="replace").strip()


def _list_venv_holder_pids(venv_dir: Path) -> set[int]:
    """List pids currently holding files under venv_dir via lsof."""
    try:
        result = subprocess.run(
            ["lsof", "+D", str(venv_dir)],
            capture_output=True,
            text=True,
        )
    except FileNotFoundError:
        return set()

    if result.returncode != 0 and not result.stdout:
        return set()

    pids: set[int] = set()
    for line in result.stdout.splitlines()[1:]:
        parts = line.split()
        if len(parts) < 2:
            continue
        try:
            pids.add(int(parts[1]))
        except ValueError:
            continue
    return pids


def _kill_pid_set(pids: set[int]) -> set[int]:
    """Terminate pids with TERM then KILL; return any pids still alive."""
    if not pids:
        return set()

    for pid in sorted(pids):
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            continue
        except PermissionError:
            continue

    deadline = time.time() + 3.0
    while time.time() < deadline:
        alive = {pid for pid in pids if Path(f"/proc/{pid}").exists()}
        if not alive:
            return set()
        time.sleep(0.2)

    alive = {pid for pid in pids if Path(f"/proc/{pid}").exists()}
    for pid in sorted(alive):
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            continue
        except PermissionError:
            continue

    time.sleep(0.2)
    return {pid for pid in pids if Path(f"/proc/{pid}").exists()}


def _recover_stale_venv_locks_for_service(argv: list[str]) -> None:
    """Best-effort cleanup for stale project CLI processes holding `.venv` on service lifecycle commands."""
    parsed = _get_service_lifecycle_action(argv)
    if not parsed:
        return
    service_name, action = parsed

    if not is_python_project():
        return

    venv_dir = SCRIPT_DIR / ".venv"
    if not venv_dir.exists():
        return

    # Only attempt automatic cleanup when NFS lock files are present (conservative default).
    nfs_lock_files = list(venv_dir.rglob(".nfs*"))
    if not nfs_lock_files:
        return

    holder_pids = _list_venv_holder_pids(venv_dir)
    if not holder_pids:
        return

    venv_python = str(venv_dir / "bin" / "python")
    venv_cli = str(venv_dir / "bin" / CLI_NAME)
    project_cli = str(SCRIPT_DIR / CLI_NAME)

    target_pids: set[int] = set()
    for pid in holder_pids:
        if pid in {os.getpid(), os.getppid()}:
            continue
        cmdline = _pid_cmdline(pid)
        if not cmdline:
            continue
        if venv_python not in cmdline:
            continue
        if any(token in cmdline for token in (venv_cli, project_cli, f" flu ")):
            target_pids.add(pid)

    if not target_pids:
        return

    pid_list = ", ".join(str(pid) for pid in sorted(target_pids))
    print(
        f"Detected stale flu processes holding {venv_dir} during service {service_name} {action}: {pid_list}"
    )
    remaining = _kill_pid_set(target_pids)
    if remaining:
        remaining_list = ", ".join(str(pid) for pid in sorted(remaining))
        print(
            f"Warning: unable to terminate all stale holders: {remaining_list}. Continuing."
        )
    else:
        print("Cleared stale project CLI holders on .venv.")


def main(argv=None) -> int:
    """Main CLI entry point -- resolves CliApp class from cli.json at runtime.

    If cli.json declares an 'app_class' key (dotted Python import path),
    that class is imported and instantiated. This allows project-specific
    CliApp subclasses to be honored after wrapper regeneration without
    requiring manual edits to the wrapper script.

    Falls back to the generic fh_commons CliApp when 'app_class' is absent.
    """
    if argv is None:
        argv = sys.argv[1:]

    import importlib
    import json

    app_class_path = None
    cli_json_path = SCRIPT_DIR / 'config' / 'cli.json'
    if cli_json_path.exists():
        with open(cli_json_path) as f:
            cli_config = json.load(f)
        app_class_path = cli_config.get('app_class')

    if app_class_path:
        module_path, class_name = app_class_path.rsplit('.', 1)
        mod = importlib.import_module(module_path)
        AppClass = getattr(mod, class_name)
    else:
        from fh_commons.cli.framework.base import CliApp as AppClass

    app = AppClass(project_root=SCRIPT_DIR)
    return app.main(argv)


if __name__ == '__main__':
    _recover_stale_venv_locks_for_service(sys.argv[1:])

    # Smart bootstrap for Python projects only
    if is_python_project() and not is_running_in_poetry_venv():
        # Recursion guard: if we've already attempted bootstrap, run directly
        if os.environ.get('_FHC_BOOTSTRAP_GUARD'):
            sys.path.insert(0, str(FH_COMMONS_DIR / 'src'))
            project_src = SCRIPT_DIR / 'src'
            if project_src.is_dir():
                sys.path.insert(0, str(project_src))
            sys.exit(main())

        # Check poetry is available before attempting bootstrap
        if not shutil.which('poetry'):
            print(
                "Error: poetry not found on PATH. "
                "Install poetry or activate the correct virtual environment.",
                file=sys.stderr,
            )
            sys.exit(1)

        # Bootstrap the Poetry environment on first install/uninstall command
        if len(sys.argv) >= 2 and sys.argv[1] in ('install', 'uninstall'):
            # Run poetry install to set up the venv
            try:
                result = subprocess.run(
                    ['poetry', 'install'],
                    cwd=SCRIPT_DIR,
                    timeout=300,
                )
            except subprocess.TimeoutExpired:
                print(
                    "Error: poetry install timed out after 5 minutes.",
                    file=sys.stderr,
                )
                sys.exit(1)
            if result.returncode != 0:
                print("Error: Poetry install failed")
                sys.exit(result.returncode)

        # Set guard before re-exec so re-entry runs directly
        os.environ['_FHC_BOOTSTRAP_GUARD'] = '1'
        # Re-exec through poetry run from the PROJECT directory
        os.chdir(SCRIPT_DIR)
        os.execvp('poetry', ['poetry', 'run', 'python3', str(Path(__file__).resolve())] + sys.argv[1:])

    # Non-Python projects or already in venv: run directly
    # Add fh-commons src to path
    sys.path.insert(0, str(FH_COMMONS_DIR / 'src'))

    # Add project src to path (needed for CliApp project command imports)
    project_src = SCRIPT_DIR / 'src'
    if project_src.is_dir():
        sys.path.insert(0, str(project_src))

    # Run the CLI
    sys.exit(main())
