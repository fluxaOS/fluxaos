# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
reports/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Phase snapshot (generated per-phase, not committed)
.phase-snapshot.json

# typescript
*.tsbuildinfo
next-env.d.ts

# project-specific
*.log
.claude/*
!.claude/AGENT_BEHAVIOR.md
!.claude/hooks/
!.claude/hooks/permission-request-allowlist.py
.paul
.trash
worktrees/
.superpowers/

# Playwright
/playwright-report
/test-results

# Per-feature isolated worktrees (using-git-worktrees skill)
.worktrees/

# fluxaOS per-run worktrees (managed by R-RUNTIME)
.fluxaos-worktrees/

# fluxaOS per-run artifacts (managed by R-ARTIFACTS)
.fluxaos-artifacts/
