#!/bin/bash
# Pre-push hook for fluxaOS
#
# Four gates:
#
#   1. Direct pushes to main are blocked. PRs only.
#
#   2. Cleanliness gate: refuse the push when the four-command snapshot
#      (`git status && git stash list && git branch && git branch -r &&
#      git worktree list`) shows leftover work that has not been
#      accounted for. The agent that calls `git push` is the one that
#      must triage whatever is left over — even if it isn't theirs.
#      That's intentional: drift can't accumulate past one push cycle.
#
#   3. Journey-test coverage gate: refuse the push when the push range
#      touches UI source (src/components/** or src/app/**/*.tsx) but
#      ships no new or modified Playwright spec under e2e/. AGENT_BEHAVIOR.md
#      requires a passing journey test BEFORE human browser sign-off;
#      this gate enforces the "test exists in the same PR" half of that
#      contract mechanically. The "test passes" half is enforced by CI
#      and by manual run before requesting sign-off.
#
#   4. Vendor-agnostic core gate (FLX-73): when the push range touches
#      src/core/ or the audit script itself, run `verify-agnostic-core.ts`
#      and refuse the push if it exits non-zero. Catches new vendor-name
#      or stage-name literals leaking into core.
#
# Cleanliness gate fails on any of:
#   - Working tree dirty (uncommitted modifications or untracked files
#     other than ignored paths). The current branch's own work must be
#     committed before pushing.
#   - ORPHAN-MERGED branches present (someone forgot `git branch -d`).
#   - ORPHAN-DANGLING branches present (unmerged + no PR + abandoned).
#   - Any stash present whose subject is not prefixed `PROTECTED:`
#     (FLX-233: agents must use temp commits, not stash).
#
# Cleanliness gate passes when every entry the audit reports is ACTIVE
# (current HEAD anywhere, ahead of origin/main) or PROTECTED (open PR
# head). Stashes pass only when every entry is `PROTECTED:`-prefixed.
#
# Resolve the failure by:
#   - Committing or discarding the working-tree changes.
#   - `git branch -d <orphan>` for merged orphans (or run
#     `bash ops/git-hooks/session-audit.sh prune`).
#   - For dangling orphans: open a PR or delete the branch.
#   - `git stash drop` for any non-`PROTECTED:` stash; future agent work
#     must use temp commits (see CLAUDE.md `## Worktrees & Hooks`). If a
#     legitimate human escape hatch is needed, relabel:
#     `git stash push -m 'PROTECTED: <reason>'`.
#
# Journey-test gate fails when:
#   - Push range touches src/components/** or src/app/**/*.tsx (or
#     src/app/**/*.ts under app router), AND
#   - Push range contains zero new or modified files under e2e/*.spec.ts.
#
# Resolve by writing a Playwright spec for the changed UI. If the change
# is genuinely unobservable from the UI (e.g. type-only refactor that
# touches a .tsx file), set FLUXAOS_SKIP_PREPUSH_GATE=1 for that push
# only and document the reason in the PR body. Bypassing without
# documentation is a violation of AGENT_BEHAVIOR.md.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ]; then
  exit 0
fi

# ── Gate 1: refuse direct push to main ─────────────────────────────────────
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    echo "✗ Direct pushes to main are blocked."
    echo ""
    echo "Use PR flow instead:"
    echo "  git push -u origin $(git branch --show-current)"
    echo "  gh pr create"
    exit 1
  fi
done

# ── Gate 2: cleanliness ────────────────────────────────────────────────────
AUDIT="$REPO_ROOT/ops/git-hooks/session-audit.sh"
if [ ! -x "$AUDIT" ]; then
  # Audit script missing — skip cleanliness gate rather than block pushes.
  exit 0
fi

JSON=$(bash "$AUDIT" json 2>/dev/null || echo '{}')

dirty=$(printf '%s' "$JSON" | grep -E '"working_tree_dirty":[[:space:]]*true' || true)
orphan_merged_count=$(printf '%s' "$JSON" | awk '/"orphan_merged":[[:space:]]*\[/,/^[[:space:]]*\]/' | grep -c '"branch"' || true)
orphan_dangling_count=$(printf '%s' "$JSON" | awk '/"orphan_dangling":[[:space:]]*\[/,/^[[:space:]]*\]/' | grep -c '"branch"' || true)
# FLX-233: any stash that isn't `PROTECTED:` blocks the push. Agents must use
# temp commits, not stash. `PROTECTED:` stays a silent human escape hatch.
stash_advisory_count=$(printf '%s' "$JSON" | awk '/"stash_advisory":[[:space:]]*\[/,/^[[:space:]]*\]/' | grep -c '"stash@' || true)

problems=0
[ -n "$dirty" ] && problems=$((problems + 1))
[ "$orphan_merged_count" -gt 0 ] && problems=$((problems + 1))
[ "$orphan_dangling_count" -gt 0 ] && problems=$((problems + 1))
[ "$stash_advisory_count" -gt 0 ] && problems=$((problems + 1))

if [ "$problems" -gt 0 ]; then
  # Block + report cleanliness failure (handled by the block below).
  :
fi

# ── Gate 3: journey-test coverage ──────────────────────────────────────────
# Determine the push range. Stdin lines from git push are
# "<local_ref> <local_sha> <remote_ref> <remote_sha>". When the remote
# ref is new (remote_sha = 0000…), use the merge-base against
# origin/main as the lower bound so we diff only what this push adds.
#
# We accumulate violations across all refs being pushed (rare but
# possible to push multiple branches at once).
ui_touched=""
e2e_touched=""

# stdin was already consumed by Gate 1's `while read` loop. Re-read it
# from the args git pre-push passes via stdin? Pre-push hooks are given
# stdin once; once consumed it's gone. Workaround: walk HEAD ranges
# against remote tracking branches we know we're about to push to.
#
# Practical heuristic that matches the common case (push current branch
# to its tracking remote): diff the current branch against origin/main.
# If the user is pushing something exotic (multiple branches, detached
# HEAD), we err on the side of running the gate against
# `origin/main..HEAD` — which still catches anything the agent did on
# this branch.
RANGE_BASE="origin/main"
if ! git rev-parse --verify "$RANGE_BASE" >/dev/null 2>&1; then
  # No origin/main yet — first push to a fresh repo. Skip Gate 3.
  RANGE_BASE=""
fi

if [ -n "$RANGE_BASE" ]; then
  # File set being pushed.
  changed=$(git diff --name-only "$RANGE_BASE...HEAD" 2>/dev/null || true)

  ui_touched=$(printf '%s\n' "$changed" | grep -E '^(src/components/|src/app/.*\.tsx?$)' || true)
  e2e_touched=$(printf '%s\n' "$changed" | grep -E '^e2e/.+\.spec\.ts$' || true)
fi

journey_gate_violation=0
if [ -n "$ui_touched" ] && [ -z "$e2e_touched" ]; then
  journey_gate_violation=1
  problems=$((problems + 1))
fi

# ── Gate 4: vendor-agnostic core (FLX-73) ─────────────────────────────────
# Refuse push when src/core/ contains unallowed vendor or stage-name
# literals. Allowlisted hits are tracked in src/scripts/verify-agnostic-core.ts.
agnostic_gate_violation=0
agnostic_output=""
if [ -n "$RANGE_BASE" ]; then
  core_touched=$(printf '%s\n' "$changed" | grep -E '^src/core/' || true)
  script_touched=$(printf '%s\n' "$changed" | grep -E '^src/scripts/verify-agnostic-core\.ts$' || true)
  if [ -n "$core_touched" ] || [ -n "$script_touched" ]; then
    if ! agnostic_output=$(npx tsx src/scripts/verify-agnostic-core.ts 2>&1); then
      agnostic_gate_violation=1
      problems=$((problems + 1))
    fi
  fi
fi

if [ "$problems" -eq 0 ]; then
  exit 0
fi

# Block + report.
echo ""
echo "✗ Push blocked."
echo ""

if [ -n "$dirty" ] || [ "$orphan_merged_count" -gt 0 ] || [ "$orphan_dangling_count" -gt 0 ] || [ "$stash_advisory_count" -gt 0 ]; then
  echo "── Cleanliness gate failed ───────────────────────────────────"
  echo ""
  echo "Four-command snapshot:"
  echo ""
  echo "── git status ────────────────────────────────────────────────"
  git status
  echo ""
  echo "── git stash list ────────────────────────────────────────────"
  git stash list || true
  echo ""
  echo "── git branch ────────────────────────────────────────────────"
  git branch --list
  echo ""
  echo "── git branch -r ─────────────────────────────────────────────"
  git branch -r --list
  echo ""
  echo "── git worktree list ─────────────────────────────────────────"
  git worktree list
  echo ""
  echo "── audit ─────────────────────────────────────────────────────"
  bash "$AUDIT" report || true
  echo ""
  echo "Resolve every flagged item before pushing again. Whoever pushes"
  echo "next inherits the cleanup obligation — that is by design so drift"
  echo "cannot accumulate past one push cycle."
  echo ""
fi

if [ "$journey_gate_violation" -eq 1 ]; then
  echo "── Journey-test coverage gate failed ─────────────────────────"
  echo ""
  echo "Push range touches UI source but adds no Playwright spec."
  echo ""
  echo "AGENT_BEHAVIOR.md: journey test must be written + passing"
  echo "BEFORE the user is asked to sign off in the browser. Shipping"
  echo "UI changes without a journey test violates the contract."
  echo ""
  echo "UI files in this push:"
  printf '%s\n' "$ui_touched" | sed 's/^/  - /'
  echo ""
  echo "Expected: at least one new or modified spec under e2e/."
  echo ""
  echo "Resolve by:"
  echo "  - Writing a Playwright spec under e2e/<feature>.spec.ts that"
  echo "    exercises the changed UI end-to-end, OR"
  echo "  - If the change is genuinely unobservable from the UI"
  echo "    (e.g. type-only refactor in a .tsx file), document the"
  echo "    reason in the PR body and bypass with"
  echo "    FLUXAOS_SKIP_PREPUSH_GATE=1 for this push only."
  echo ""
fi

if [ "$agnostic_gate_violation" -eq 1 ]; then
  echo "── Vendor-agnostic core gate failed ──────────────────────────"
  echo ""
  echo "src/core/ contains unallowed vendor-name or stage-name literals."
  printf '%s\n' "$agnostic_output"
  echo ""
  echo "Fix by:"
  echo "  - Removing the literal (preferred), OR"
  echo "  - Filing a follow-up ticket and adding the file:line to the"
  echo "    ALLOWLIST in src/scripts/verify-agnostic-core.ts."
  echo ""
fi

echo "If you genuinely need to bypass (rare; document why), set"
echo "FLUXAOS_SKIP_PREPUSH_GATE=1 for this push only."

if [ "${FLUXAOS_SKIP_PREPUSH_GATE:-0}" = "1" ]; then
  echo ""
  echo "⚠  FLUXAOS_SKIP_PREPUSH_GATE=1 — bypassing pre-push gates."
  exit 0
fi

exit 1
