#!/bin/bash
# Pre-commit hook for fluxaOS (standalone — no fh-commons dependency)
set -e

ERRORS=0

# ── Branch protection ──
# Block direct (non-merge) commits to main. Merge commits finalizing a
# `git merge <branch>` are permitted because their content was already
# vetted on the feature branch by this same hook and the commit-msg gate.
GIT_DIR=$(git rev-parse --git-dir)
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" = "main" ] && [ ! -f "$GIT_DIR/MERGE_HEAD" ]; then
  echo "✗ Direct commits to 'main' branch are not allowed"
  echo ""
  echo "Please create a feature branch:"
  echo "  git checkout -b your-branch-name"
  exit 1
fi

# ── Lint staged TypeScript files ──
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)
if [ -n "$STAGED_TS" ]; then
  echo "Running lint..."
  npx eslint $STAGED_TS --quiet 2>/dev/null || {
    echo "✗ ESLint failed"
    ERRORS=$((ERRORS + 1))
  }
fi

# ── File size check (500 lines max) ──
# Exempt files where length is unavoidable or architecturally justified.
# Add a new entry below with a one-line rationale comment above it.
# See DEF-007 (docs/superpowers/deferred-fixes.md) for the canonical-source TODO.
SIZE_EXEMPT_FILES=(
  # Declarative Drizzle schema: one entity per block; splitting fragments the FK graph
  # and makes relations harder to read.
  "src/core/db/schema.ts"
  # End-to-end integration test: single-file arrange/act/assert flow is clearer than
  # split. DEF-008 candidate if we want to split later.
  "src/__tests__/integration/orchestrator.test.ts"
  # Catalog + default-org/user/project seed data: linear top-to-bottom reads best as
  # one file. DEF-008 candidate if we want to split later.
  "src/scripts/db/seed.ts"
  # Gate engine integration tests: pure-function + service tests interleaved with
  # shared fixtures. DEF-008 candidate if we split engine vs service tests later.
  "src/__tests__/integration/gates.test.ts"
  # Issue service: single source of truth for issue lifecycle. Splitting the
  # transition / state-override / epic-auto-close helpers across files
  # fragments the invariant graph (version locks, close propagation, event
  # emission). See AUDIT-P2-CQ-CORE-7 for the standing exemption rationale.
  "src/core/services/issue.ts"
  # Services integration test: pre-existing oversize. Splitting fragments
  # the invariant arrange/act/assert flow across files. DEF-008 candidate.
  "src/__tests__/integration/services.test.ts"
  # Event orchestrator: subscribes to pipeline_run + stage_run lifecycles
  # in a single state machine. Splitting fragments the run/stage/gate
  # event ordering invariant. (Crossed 500 lines after R-RUNTIME work.)
  "src/core/orchestrator/event-orchestrator.ts"
  # Stage runner: owns the full subprocess + isolation + event emission
  # lifecycle for one stage_run. Splitting separates lifecycle phases
  # that share invariants and exit semantics.
  "src/core/orchestrator/stage-runner.ts"
)

is_size_exempt() {
  local target="$1"
  for exempt in "${SIZE_EXEMPT_FILES[@]}"; do
    if [ "$target" = "$exempt" ]; then
      return 0
    fi
  done
  return 1
}

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)
for file in $STAGED_FILES; do
  if [ -f "$file" ]; then
    if is_size_exempt "$file"; then
      continue
    fi
    LINES=$(wc -l < "$file")
    if [ "$LINES" -gt 500 ]; then
      echo "✗ $file exceeds 500 lines ($LINES lines)"
      ERRORS=$((ERRORS + 1))
    fi
  fi
done

# ── Secret detection ──
STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACM || true)
for file in $STAGED_ALL; do
  if echo "$file" | grep -qE '(^|/)secrets/|\.token$'; then
    echo "✗ Potential secret file staged: $file"
    ERRORS=$((ERRORS + 1))
    continue
  fi

  if echo "$file" | grep -qE '\.env\.example$'; then
    continue
  fi

  if echo "$file" | grep -qE '\.env$|\.env\.'; then
    echo "✗ Potential secret file staged: $file"
    ERRORS=$((ERRORS + 1))
  fi
done

if [ $ERRORS -eq 0 ]; then
  echo "✓ Pre-commit checks passed"
  exit 0
else
  echo ""
  echo "✗ Pre-commit checks failed with $ERRORS error(s)"
  exit 1
fi
