{
  "__meta": {
    "description": "Memory system configuration synced from fh-commons",
    "version": "1.0.0",
    "managed_by": "fhc sync",
    "note": "DO NOT EDIT — this file is overwritten by fhc sync. Edit templates/shared-config/memory.json in fh-commons."
  },
  "memory": {
    "database": {
      "type": "postgresql",
      "host": "192.168.54.101",
      "port": 5432,
      "name": "fhc_memory",
      "user": "fhc_memory",
      "password": "fhc_memory_2026"
    },
    "redis": {
      "host": "192.168.54.101",
      "port": 6379,
      "db": 2
    },
    "categories": [
      "file_index",
      "investigation",
      "architecture",
      "troubleshooting",
      "pattern",
      "decision",
      "session"
    ],
    "indexer": {
      "file_types": [".py"],
      "exclude_patterns": ["__pycache__", ".git", "node_modules", ".venv", "*.pyc", ".eggs", "*.egg-info"],
      "max_depth": 10
    },
    "staleness": {
      "check_on_search": true,
      "stale_after_commits": 10,
      "stale_after_days": 90
    },
    "gc": {
      "delete_stale_after_days": 180,
      "delete_orphaned": true,
      "protect_verified_days": 30
    },
    "digest": {
      "auto_on_finish": true,
      "auto_on_pr_merge": true,
      "include_pr_comments": true,
      "skip_labels": ["state:wontfix"],
      "min_comments_for_investigation": 2
    },
    "commit_ingestion": {
      "skip_merge_commits": true,
      "min_message_length": 20,
      "skip_authors": [],
      "include_diff_stats": true
    },
    "review_ingestion": {
      "min_comment_length": 50,
      "skip_authors": [],
      "skip_trivial_approvals": true,
      "include_inline_context": true,
      "group_threads": true
    },
    "cache": {
      "enabled": true,
      "search_ttl_seconds": 3600,
      "entry_ttl_seconds": 86400,
      "max_recent": 50
    },
    "feedback": {
      "weight_in_search": 0.1,
      "auto_stale_threshold": -3,
      "ratings": ["useful", "not_useful", "partial"]
    },
    "claude_memory_ingestion": {
      "home_dir": "/home/jpierce",
      "memory_glob": ".claude/projects/*/memory/*.md",
      "exclude_files": [],
      "section_min_length": 50
    },
    "vector": {
      "enabled": true,
      "model": "BAAI/bge-small-en-v1.5",
      "dimensions": 384,
      "batch_size": 32,
      "search_weight": 0.5
    },
    "context_injection": {
      "enabled": true,
      "token_budget": 2000,
      "max_results": 5,
      "search_mode": "auto"
    }
  }
}
