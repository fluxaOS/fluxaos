# ─── Database ────────────────────────────────────────────────────────────────
# Set automatically by docker-compose.yml — only needed for local dev
# DATABASE_URL=postgres://postgres:supersecure@localhost:5432/fluxaos

# ─── Redis ───────────────────────────────────────────────────────────────────
# Set automatically by docker-compose.yml — only needed for local dev
# REDIS_URL=redis://:redispass@localhost:6379

# ─── Docker Compose Passwords ───────────────────────────────────────────────
POSTGRES_PASSWORD=supersecure
REDIS_PASSWORD=redispass

# ─── Supabase Auth (required for login) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── GitHub Integration ─────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_your_personal_access_token

# ─── AI Providers (Phase 6+) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key
# OPENAI_API_KEY=sk-your-key

# ─── Adapter Overrides (optional — defaults shown) ──────────────────────────
# FLUXAOS_AUTH_PROVIDER=supabase
# FLUXAOS_GIT_PROVIDER=github
# FLUXAOS_ISSUE_PROVIDER=github
# FLUXAOS_AI_PROVIDERS=anthropic
# FLUXAOS_QUEUE_PROVIDER=bullmq
# FLUXAOS_STAGE_EXECUTOR=node-exec
# FLUXAOS_REALTIME_PROVIDER=supabase
