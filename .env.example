# ─── Supabase project refs (FLX-230) ───────────────────────────────────────
# Two Supabase projects back fluxaOS. The project ref appears in
# DATABASE_URL as `postgres.<ref>` and in NEXT_PUBLIC_SUPABASE_URL as
# `https://<ref>.supabase.co`. Mixing them up is how FLX-123 happened.
#
#   Dev: dpdjlnpvxkepkwzwuvim   (file: /mnt/dev/fluxaos/.env.local)
#   UAT: zesinfsluyxiwzldeffa   (file: /mnt/stacks/docker/fluxaos/fluxaos.env)
#
# Verify before committing config changes:
#   ./flux env audit
#
# Example dev DATABASE_URL (real password lives in 1Password "Agents/Supabase/dev info"):
#   DATABASE_URL="postgresql://postgres.dpdjlnpvxkepkwzwuvim:[PASSWORD]@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Example UAT DATABASE_URL (real password lives in 1Password "Agents/Supabase/UAT info"):
#   DATABASE_URL="postgresql://postgres.zesinfsluyxiwzldeffa:[PASSWORD]@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ─── Supabase Cloud ─────────────────────────────────────────────────────────
# Transaction pooler (port 6543) — used by the app at runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — used for migrations only
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Auth (Settings → API in Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Redis (local container) ───────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Pipeline result-doc scripts (required, no defaults) ───────────────────
# Paths to the bundled .mjs scripts invoked by the stage runner via node.
# Operator owns these — boot fails fast if either is unset (FLX-212).
FLUXAOS_INIT_RESULT_DOC_SCRIPT=.next/daemon/init-result-doc.mjs
FLUXAOS_INGEST_RESULT_DOC_SCRIPT=.next/daemon/ingest-result-doc.mjs

# ─── App URL (required for SSR tRPC) ───────────────────────────────────────
# Absolute base URL the server uses to call its own tRPC API during SSR.
# Required — boot fails fast if unset (FLX-211).
#   Dev: http://192.168.54.101:3004
#   UAT: https://uat-flux.jdp21.com
NEXT_PUBLIC_APP_URL=http://localhost:3004

# ─── e2e seed project coordinates (FLX-245) ──────────────────────────────────
# Must match the org/user/project slugs created by `npm run db:seed`.
# Default seed values shown below — update if you use a different seed.
FLUXAOS_ORG_SLUG=default
FLUXAOS_USER_SLUG=admin
FLUXAOS_PROJECT_SLUG=fluxaos
